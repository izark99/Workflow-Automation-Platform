{
  "name": "data-flow-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages && node scripts/check-dist-size.mjs dist",
    "bench:generate": "node scripts/generate-bench-files.ts bench-data",
    "spike:smoke": "playwright test -c playwright.spike.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "spike": "node scripts/spike.ts",
    "test:acceptance": "playwright test -c playwright.acceptance.config.ts",
    "test:acceptance:pages": "VITE_DUCKDB_SOURCE=cdn playwright test -c playwright.acceptance.config.ts",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "test:ui-rules": "playwright test -c playwright.ui-rules.config.ts",
    "perf:canvas": "node scripts/perf-canvas.ts",
    "test:db": "node scripts/test-db.mjs",
    "test:store": "node scripts/test-store.mjs",
    "test:functions": "node scripts/test-functions.mjs",
    "gates": "npm run check && npm run spike && npm run test:acceptance && npm run test:e2e && npm run test:ui-rules && npm run test:db && npm run test:functions"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "@xyflow/react": "13.0.1",
    "apache-arrow": "17.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "supabase": "3.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
